# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Screenshots (created at runtime, can be large)
screenshots/

# Data files - exclude from image so they're created fresh at runtime
# This prevents Docker image from overwriting runtime changes
data/monitors.json
data/test_results.json

# But allow default_monitors.json to be included
!default_monitors.json

# Documentation
*.md
!readme.md

# Tests
test_*.py
*_test.py

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db




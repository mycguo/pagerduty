# Example environment variables
# Copy this file to .env and fill in your values

# Credentials for test applications
TEST_USERNAME=user@example.com
TEST_PASSWORD=your_password_here

# Email Alert Configuration (SMTP)
# For Gmail: smtp.gmail.com:587 (use App Password, not your regular password)
# For SendGrid: smtp.sendgrid.net:587
# For Mailgun: smtp.mailgun.org:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

  {
    "id": "1b90b4a8-a53b-4902-80ca-154429f17806",
    "name": "Wikipedia Health Check",
    "url": "https://www.wikipedia.org",
    "steps": [
      {
        "type": "navigate",
        "url": "https://www.wikipedia.org"
      },
      {
        "type": "verify",
        "condition": "element_exists",
        "selector": "#searchInput"
      },
      {
        "type": "fill",
        "selector": "#searchInput",
        "value": "Python programming"
      },
      {
        "type": "click",
        "selector": "button[type='submit']"
      },
      {
        "type": "wait",
        "wait_type": "time",
        "duration": 2000
      },
      {
        "type": "verify",
        "condition": "url_contains",
        "expected": "wikipedia.org"
      }
    ],
    "enabled": true,
    "schedule": "*/5 * * * *",
    "created_at": "2025-12-08T12:59:50.334448",
    "updated_at": "2025-12-08T12:59:50.334452"
  },
